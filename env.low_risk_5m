# 5m Minimal-Risk Profile
MODE=BACKTEST
SYMBOL=BTCUSDT
INTERVAL=5m
LOOKBACK_LIMIT=1500

# Execution/Costs assumptions (conservative)
FEES_BP=10
SLIPPAGE_BP=7

# Risk controls
RISK_PCT=0.001          # 0.10% risk per trade
MAX_DAILY_LOSS=0.01     # 1% daily loss stop

# Volatility gates (in percent of price)
MIN_ATR_PCT=0.10        # avoid dead markets
MAX_ATR_PCT=1.20        # avoid chaotic spikes

# Indicators
EMA_FAST=21
EMA_SLOW=55
RSI_PERIOD=14
ATR_PERIOD=14

# Stops / Targets (more conservative, tighter trail)
ATR_STOP_K=2.2          # wider initial SL to avoid noise
ATR_TRAIL_K=1.0         # tighter trail to lock gains
TP1_R=0.8               # small first target
TP2_R=1.6               # second target
PARTIAL_TP1=0.6         # take 60% at TP1

# Backtest funding
PAPER_BALANCE=1000
